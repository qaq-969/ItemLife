# ============================================================
# ItemLife 环境变量样例：复制为 .env 后填写（make gen-secrets 可自动生成随机值）
# ============================================================

# ---------- 数据库 ----------
MYSQL_DATABASE=itemlife
MYSQL_USER=itemlife
# 应用连接数据库的口令（必填）
DB_PASSWORD=change-me-db-password
# MySQL root 口令（仅本地运维用，必填）
DB_ROOT_PASSWORD=change-me-root-password

# ---------- Redis ----------
REDIS_PASSWORD=change-me-redis-password

# ---------- 应用密钥（务必使用随机值，禁用默认值上线）----------
# Access Token 签名密钥（≥32 字符随机串）
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
# Refresh Token 签名密钥（与 JWT_SECRET 不同）
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-32-chars
# TOTP 密钥 AES-256-GCM 加密主密钥：base64 的 32 字节（openssl rand -base64 32）
TOTP_ENC_KEY=change-me-base64-32-bytes

# ---------- 连接串 ----------
# 本地开发（pnpm dev:api 直连宿主机端口）使用下面的默认值；容器运行时由 compose 覆盖为服务名地址。
# 若手工修改了 DB_PASSWORD / REDIS_PASSWORD，请同步修改这两行（make gen-secrets 会自动重建）。
DATABASE_URL=mysql://itemlife:change-me-db-password@127.0.0.1:3306/itemlife
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379/0

# ---------- 服务端口 / 运行参数 ----------
API_PORT=3000
# web 容器对外发布的 HTTP 端口（TLS 由容器外部的反向代理终止，详见设计报告 10.5）
WEB_PORT=80
# 前端同源访问时留空即可；跨域开发时填写前端地址（逗号分隔）
CORS_ORIGINS=

# 部署在外部反向代理（Nginx / Caddy / 路由设备）之后时置为 2，
# 以便按 X-Forwarded-* 识别真实客户端 IP（详见设计报告 10.5）：
#   0 = 不信任任何代理；1 = 仅经 web 容器（无外部代理）；2 = 外部反向代理 + web 容器
TRUST_PROXY=2

# 首次启动时写入开发种子数据（含示例账号 dev@itemlife.local），生产环境请保持 0
SEED_ON_START=0
