{
  "name": "itemlife",
  "version": "0.1.0",
  "private": true,
  "description": "ItemLife —— 以物品为视角的个人 / 家庭记账 Web 应用（Monorepo）",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "dev:infra": "docker compose up -d mysql redis",
    "dev:api": "pnpm --filter @itemlife/api start:dev",
    "dev:web": "pnpm --filter @itemlife/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "postinstall": "node scripts/postinstall.mjs",
    "format": "prettier --write \"**/*.{ts,vue,json,md,yml,yaml}\"",
    "compose:config": "docker compose config -q"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
