{
  "name": "@itemlife/api",
  "version": "0.1.0",
  "private": true,
  "description": "ItemLife 后端（NestJS + Prisma）",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "dev:memory": "ts-node --transpile-only scripts/dev-memory.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:auth": "ts-node --transpile-only scripts/auth-smoke.ts",
    "smoke:ledger": "ts-node --transpile-only scripts/ledger-smoke.ts",
    "smoke:items": "ts-node --transpile-only scripts/items-smoke.ts",
    "smoke:m4m5": "ts-node --transpile-only scripts/m4-m5-smoke.ts",
    "smoke:site-admin": "ts-node --transpile-only scripts/site-admin-smoke.ts",
    "smoke:accessory-delete": "node scripts/accessory-delete-smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@itemlife/shared": "workspace:*",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
